-
     fn rub_to_frd(v: &Vector3<f32>) -> Vector3<f32> {
         let result = Vector3::new(-v.z, v.x, -v.y);
         result
@@ -318,7 +305,14 @@ impl Fusion for NaiveCF {
     }
 
     fn update(&mut self) -> () {
-        let event = self.next_event();
+        if let Err(e) = self.try_update() {
+            println!("Error reading event: {}", e);
+            std::process::exit(0);
+        }
+    }
+
+    fn try_update(&mut self) -> Result<()> {
+        let event = self.glasses.read_event()?;
         match event {
             GlassesEvent::AccGyro {
                 accelerometer,
@@ -334,5 +328,6 @@ impl Fusion for NaiveCF {
                 //TODO: add magnetometer event etc
             }
         }
+        Ok(())
     }
 }
