From 7f509e8ac90a7875ed6bdf152445f45c02e712aa Mon Sep 17 00:00:00 2001
From: KC <kitaclang@gmail.com>
Date: Sun, 8 Nov 2026 09:53:04 +0700
Subject: [PATCH] Add try_update and try_any_fusion that return errors instead
 of exiting

Fusion::update() and any_fusion() call std::process::exit(0) when the
glasses can't be found or reading from them fails, for example when
they are unplugged. That ends the whole host app.

Add fallible versions next to them:

- Fusion::try_update() returns the read error. Its default
  implementation calls update(), so existing Fusion implementations
  keep compiling. NaiveCF and FusionWithOffset implement it properly.
- try_any_fusion() uses any_glasses() instead of
  any_glasses_or_fail(), so it returns NotFound instead of exiting.

update() and any_fusion() behave as before. The one change in behaviour
is that NaiveCF::new() now returns a read error during its start-up
wait instead of exiting; it already returned a Result.

Also expose the latest calibrated FRD gyro sample and device timestamp for
opt-in drift diagnostics. Allow an explicitly measured residual body-frame gyro
bias to be subtracted before integration (zero by default). Fix the initial
gyro sample to use FRD too, and test the correction with synthetic samples.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
diff --git a/Cargo.toml b/Cargo.toml
index 22ef41e..5cf3a1a 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -46 +46,4 @@ clap = { version = "4.3", features = ["derive"] }
 crate-type = ["cdylib", "rlib"]
+
+# Keep the cached checkout independently testable inside another workspace.
+[workspace]
diff --git a/src/lib.rs b/src/lib.rs
index 6a85b6a..a0c80c1 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -123,3 +123,29 @@ pub trait Fusion: Send {
 
+    /// Latest calibrated gyro rate in FRD radians/second and device timestamp in microseconds.
+    /// Diagnostic access only; unsupported fusion implementations return None.
+    fn gyro_sample_frd(&self) -> Option<([f32; 3], u64)> {
+        None
+    }
+
+    /// Set a stationary, body-relative residual gyro bias (FRD radians/second).
+    /// Replaces the previous bias; unsupported fusion implementations return an error.
+    fn set_gyro_bias_frd(&mut self, _bias: [f32; 3]) -> Result<()> {
+        Err(Error::NotImplemented)
+    }
+
+    /// Read the next event from the glasses and update the estimate. Blocks.
+    ///
+    /// Exits the process if reading fails, for example when the glasses are unplugged.
+    /// Use [`Fusion::try_update`] to handle that instead.
     fn update(&mut self) -> ();
+
+    /// Like [`Fusion::update`], but returns the error instead of exiting the process when
+    /// reading from the glasses fails (for example when they are unplugged), so the caller
+    /// can drop this fusion and reconnect with [`try_any_fusion`].
+    ///
+    /// The default implementation calls [`Fusion::update`] and never returns an error.
+    fn try_update(&mut self) -> Result<()> {
+        self.update();
+        Ok(())
+    }
 }
@@ -155,2 +181,14 @@ impl Fusion for FusionWithOffset {
 
+    fn try_update(&mut self) -> Result<()> {
+        self.fusion.try_update()
+    }
+
+    fn gyro_sample_frd(&self) -> Option<([f32; 3], u64)> {
+        self.fusion.gyro_sample_frd()
+    }
+
+    fn set_gyro_bias_frd(&mut self, bias: [f32; 3]) -> Result<()> {
+        self.fusion.set_gyro_bias_frd(bias)
+    }
+
     fn attitude_quaternion(&self) -> UnitQuaternion<f32> {
@@ -162,2 +200,5 @@ impl Fusion for FusionWithOffset {
 
+/// Connect to any supported glasses and start sensor fusion.
+///
+/// Exits the process if no glasses are found. Use [`try_any_fusion`] to get an error instead.
 pub fn any_fusion() -> Result<Box<dyn Fusion>> {
@@ -168,2 +209,10 @@ pub fn any_fusion() -> Result<Box<dyn Fusion>> {
 
+/// Like [`any_fusion`], but returns an error instead of exiting the process when no glasses
+/// are found or reading from them fails, so the caller can retry (for example until the
+/// glasses are plugged in). Pair it with [`Fusion::try_update`].
+pub fn try_any_fusion() -> Result<Box<dyn Fusion>> {
+    let glasses = any_glasses()?;
+    Ok(Box::new(NaiveCF::new(glasses)?))
+}
+
 type Rw<T> = Arc<Mutex<T>>;
diff --git a/src/naive_cf.rs b/src/naive_cf.rs
