+}
+
+#[cfg(test)]
+mod bias_tests {
+    use super::*;
+    use crate::{DisplayMode, Side};
+    use nalgebra::Isometry3;
+
+    struct StationaryGlasses(u64);
+    impl ARGlasses for StationaryGlasses {
+        fn serial(&mut self) -> Result<String> { Err(Error::NotImplemented) }
+        fn read_event(&mut self) -> Result<GlassesEvent> {
+            Ok(GlassesEvent::AccGyro {
+                accelerometer: Vector3::new(0.0, 9.81, 0.0),
+                gyroscope: Vector3::new(0.002, 0.003, -0.001),
+                timestamp: self.0,
+            })
+        }
+        fn get_display_mode(&mut self) -> Result<DisplayMode> { Err(Error::NotImplemented) }
+        fn set_display_mode(&mut self, _: DisplayMode) -> Result<()> { Err(Error::NotImplemented) }
+        fn display_fov(&self) -> f32 { 0.0 }
+        fn imu_to_display_matrix(&self, _: Side, _: f32) -> Isometry3<f64> { Isometry3::identity() }
+        fn name(&self) -> &'static str { "test" }
+        fn display_delay(&self) -> u64 { 0 }
+    }
+
+    #[test]
+    fn invalid_timestamps_are_rejected_before_integration() {
+        let mut fusion = NaiveCF::new(Box::new(StationaryGlasses(100))).unwrap();
+        let initial = fusion.attitude;
+        fusion.prev_gyro.1 = 101;
+        assert!(fusion.try_update().is_err());
+        assert_eq!(fusion.attitude, initial);
+        fusion.prev_gyro.1 = 0;
+        // A duplicate or normal sample remains valid.
+        assert!(fusion.try_update().is_ok());
+        let mut stalled = NaiveCF::new(Box::new(StationaryGlasses(1_000_001))).unwrap();
+        stalled.prev_gyro.1 = 0;
+        let initial = stalled.attitude;
+        assert!(stalled.try_update().is_err());
+        assert_eq!(stalled.attitude, initial);
+    }
+
+    #[test]
+    fn bias_is_subtracted_in_body_frame_before_integration_and_preserves_motion() {
+        let mut fusion = NaiveCF::new(Box::new(StationaryGlasses(100))).unwrap();
+        let bias = [0.001, 0.002, -0.003]; // RUB -> FRD
+        let (raw, time) = fusion.gyro_sample_frd().unwrap();
+        assert_eq!(raw, bias);
+        assert_eq!(time, 100);
+        fusion.set_gyro_bias_frd(bias).unwrap();
+        let gyro = Vector3::new(0.002, 0.003, -0.001);
+        let initial = UnitQuaternion::from_euler_angles(0.3, -0.4, 0.5);
+        fusion.attitude = initial;
+        for i in 1..=1000 {
+            fusion.update_gyro_rub(&gyro, 100 + i * 1000);
+        }
+        assert!(fusion.attitude.angle_to(&initial) < 1e-6);
+        assert_eq!(fusion.gyro_sample_frd().unwrap().0, bias); // diagnostic stays raw
+        assert!(fusion.set_gyro_bias_frd([f32::NAN; 3]).is_err());
+        fusion.set_gyro_bias_frd(bias).unwrap(); // replacement, not accumulation
+        // Genuine motion on all three axes must remain, including at a tilted attitude.
+        let motion = Vector3::new(0.1, -0.2, 0.3);
+        let moving_rub = gyro + Vector3::new(motion.y, -motion.z, -motion.x);
+        fusion.update_gyro_rub(&moving_rub, 1_010_100);
+        let expected = initial * UnitQuaternion::from_euler_angles(0.001, -0.002, 0.003);
+        assert!(fusion.attitude.angle_to(&expected) < 1e-6);
+        fusion.set_gyro_bias_frd([0.0; 3]).unwrap();
+        assert_eq!(fusion.gyro_bias_frd, Vector3::zeros());
+        let fresh = NaiveCF::new(Box::new(StationaryGlasses(100))).unwrap();
+        assert_eq!(fresh.gyro_bias_frd, Vector3::zeros());
     }
