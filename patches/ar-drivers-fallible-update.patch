-    }
-
     fn rub_to_frd(v: &Vector3<f32>) -> Vector3<f32> {
@@ -144,3 +135,3 @@ impl NaiveCF {
         let d_t1_f = d_t1 as f32 / Self::GYRO_SPEED_IN_TIMESTAMP_FACTOR;
-        let d_s1_t1 = d_t1_f * gyro;
+        let d_s1_t1 = d_t1_f * (gyro - self.gyro_bias_frd);

@@ -315,2 +306,15 @@ impl Fusion for NaiveCF {
 
+    fn gyro_sample_frd(&self) -> Option<([f32; 3], u64)> {
+        let (rate, timestamp) = self.prev_gyro;
+        Some(([rate.x, rate.y, rate.z], timestamp))
