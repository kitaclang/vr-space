+
+    fn set_gyro_bias_frd(&mut self, bias: [f32; 3]) -> Result<()> {
+        if !bias.iter().all(|v| v.is_finite()) {
+            return Err(Error::Other("gyro bias must be finite"));
+        }
+        self.gyro_bias_frd = Vector3::from(bias);
+        Ok(())
+    }
+
     fn inconsistency_frd(&self) -> f32 {
@@ -320,3 +324,10 @@ impl Fusion for NaiveCF {
     fn update(&mut self) -> () {
-        let event = self.next_event();
+        if let Err(e) = self.try_update() {
+            println!("Error reading event: {}", e);
+            std::process::exit(0);
+        }
+    }
+
+    fn try_update(&mut self) -> Result<()> {
+        let event = self.glasses.read_event()?;
         match event {
@@ -327,2 +338,5 @@ impl Fusion for NaiveCF {
             } => {
+                if timestamp < self.prev_gyro.1 || timestamp - self.prev_gyro.1 > 1_000_000 {
+                    return Err(Error::Other("gyro timestamp reversed or stalled"));
+                }
                 self.update_gyro_rub(&gyroscope, timestamp);
@@ -336,2 +350,75 @@ impl Fusion for NaiveCF {
         }
+        Ok(())
