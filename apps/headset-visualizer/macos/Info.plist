<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template for vr-space.app. scripts/bundle-macos.sh fills in @VERSION@. -->
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>vr-space</string>
	<key>CFBundleDisplayName</key>
	<string>vr-space</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.kitaclang.vr-space</string>
	<key>CFBundleExecutable</key>
	<string>vr-space</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleVersion</key>
	<string>@VERSION@</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>LSMinimumSystemVersion</key>
	<string>12.3</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<!-- Menu bar app: no Dock icon (the app also sets ActivationPolicy::Accessory). -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>MIT License</string>
</dict>
</plist>
